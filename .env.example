# Configuration for `docker compose` (copy to .env). The local development servers read backend/.env
# instead (see backend/.env.example). The main settings are explained in README.md.

# ---- Required ----
# Public address of the site, with scheme and no trailing slash. Used in emails and CSRF checks.
SITE_URL=http://localhost:8080
# Long random value, e.g.  openssl rand -base64 48   (changing it signs everyone out)
DJANGO_SECRET_KEY=
# Database password. Keep it URL-safe (letters and digits): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Hostnames the API answers to, comma separated (a leading dot also matches subdomains).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- HTTPS ----
# The defaults below let you try Doory over plain http://localhost. Behind a TLS-terminating proxy
# (production), set both to true.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false
# Reverse proxies between the internet and the API, as seen by rate limiting (bundled nginx = 1;
# add one for each extra proxy that does not rewrite X-Forwarded-For).
NUM_PROXIES=1

# ---- Ports and build options ----
WEB_PORT=8080
# Interface the web port is published on. Use 127.0.0.1 when a reverse proxy on the same host fronts it.
WEB_BIND=0.0.0.0
# Build headless Chromium into the API image for server-side PDF export (adds ~400 MB). false = off.
INSTALL_CHROMIUM=true

# ---- Optional: first-run content (the commands are listed in README.md) ----
# Without it a new site has no icons, emoji or illustrations, no fonts besides the system ones and no
# background-removal model. These flags run the downloads inside the API container *before* it starts
# serving; a failed download is logged and never stops the server. The first start can take minutes
# (Compose reports the API as unhealthy for as long as it takes), so for a first install you may prefer
# `docker compose exec api python manage.py ...` once the stack is up, and these flags afterwards.
# Template categories: docker compose exec api python manage.py seed_gallery

# Element library (icons, emoji, illustrations, shapes, graphics): about 27 500 elements,
# about 40 s and 120-130 MB on disk the first time, a second afterwards. true: run on every start.
DOORY_SYNC_ELEMENTS=false
# Extra arguments for `manage.py sync_element_packs`, e.g. --pack lucide phosphor-regular
DOORY_SYNC_ELEMENTS_ARGS=

# Font catalog (OFL fonts from Fontsource via jsDelivr). true: download once, on the first start.
DOORY_SYNC_FONTS=false
# Which families (default when empty: the 100 most popular, about 6 MB). e.g. --popular 253 or --all
DOORY_SYNC_FONTS_ARGS=

# The ten starter templates (backend/data/templates, with thumbnails). true: add them on every start. Add-only:
# a template that already exists is never changed, so edits made in the admin survive. Needs the fonts above.
DOORY_SEED_TEMPLATES=false

# Background-removal model (U2-Net small, Apache-2.0, 4.6 MB, into MEDIA_ROOT/models/). true: run on every
# start (an installed model costs a hash check, no download).
DOORY_SYNC_MODELS=false
# Extra arguments for `manage.py sync_models`, e.g. --model u2net (176 MB) or --all
DOORY_SYNC_MODELS_ARGS=

# Audio library (24 music loops and 88 sound effects, CC0, about 7 MB, into MEDIA_ROOT/audio/): installed from the
# files in the image, no download. true: run on every start (installed files cost a hash check).
DOORY_SYNC_AUDIO=false
# Extra arguments for `manage.py sync_audio`, e.g. --pack some-pack (optional CC0 packs listed in the manifest)
DOORY_SYNC_AUDIO_ARGS=

# ---- Optional: server-side image export (PNG/JPG/WebP of a design page, drawn by the PDF browser) ----
# Needs INSTALL_CHROMIUM=true. Defaults to the PDF export's on/off switch.
# SERVER_IMAGE_EXPORT_ENABLED=true
# The frontend's headless render page, as the API container reaches it (the web service on the compose
# network). It must be the built frontend: the export browser only loads this page and /assets/ from it.
EXPORT_RENDER_PAGE_URL=http://web:8080/render.html
# Largest output in pixels (width x height, after scaling) and largest design document drawn.
# EXPORT_IMAGE_MAX_PIXELS=40000000
# EXPORT_IMAGE_MAX_DOCUMENT_BYTES=5242880

# ---- Optional: your own size presets ----
# The sizes offered when creating or resizing a design. The built-in ones are added on the first migration
# and can be edited in the admin (Size presets). To manage them as a file instead, point this at a JSON file
# inside the API container (mount it, see docker-compose.yml); it is imported on every start, so editing the
# file and restarting updates the site's sizes. The format is in README.md. Empty: no import.
DOORY_SIZE_PRESETS_FILE=
# extend: the file adds to the built-in sizes (a preset with the same slug replaces the built-in one).
# replace: only the file's groups and sizes are offered; the others are switched off, not deleted.
DOORY_SIZE_PRESETS_MODE=extend

# ---- Optional: email (default prints emails to the container log) ----
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=Doory <no-reply@example.com>

# ---- Optional: Google sign-in (OAuth web client ID) ----
# GOOGLE_CLIENT_ID=

# ---- Optional: stock photo search (a provider is offered when its key is set) ----
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Which providers are on, in tab order; the "All" tab searches STOCK_ALL_PROVIDERS (empty: all of them) in parallel.
# STOCK_PROVIDERS=unsplash,pexels,pixabay
# STOCK_ALL_PROVIDERS=
# STOCK_ALL_TIMEOUT_SECONDS=4
# STOCK_DEFAULT_TAB=all
# Per provider (UNSPLASH, PEXELS, PIXABAY): search cache time (3600 s; Pixabay 86400 s), safe search (Unsplash off,
# Pixabay on) and a cap on calls per API key across all users. No cap is set by default: Doory then only pauses a
# provider when it answers 429 or reports its quota used up. The providers' published limits, to set as caps:
# Unsplash 50/h (demo) or 5000/h (production), Pexels 200/h, Pixabay 100/m.
# STOCK_UNSPLASH_RATE=5000/h
# STOCK_UNSPLASH_SAFESEARCH=false
# STOCK_PIXABAY_CACHE_SECONDS=86400
# STOCK_PIXABAY_RATE=100/m
# STOCK_PIXABAY_SAFESEARCH=true
# STOCK_PIXABAY_IMAGE_TYPE=photo   # photo, illustration, vector or all
# STOCK_LANG_FROM_UI=true          # search Pixabay in the UI language

# ---- Optional: MCP server for AI assistants (/mcp; tokens are made in Settings). Off by default. ----
# MCP_ENABLED=true
# COMPOSE_PROFILES=mcp         # Docker: also start the `mcp` service
# MCP_CALLS_PER_MINUTE=120     # per user; 0 = unlimited
# MCP_URL_UPLOADS=true         # let assistants copy images from public https URLs
# MCP_WORKERS=1                # uvicorn workers of the `mcp` service (Docker)
# MCP_MEM_LIMIT=1g             # memory cap of the `mcp` service (Docker)

# ---- Optional: S3-compatible media storage instead of the local volume ----
# USE_S3=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
