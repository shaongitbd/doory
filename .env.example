# Configuration for `docker compose` (copy to .env). The local development servers read backend/.env
# instead (see backend/.env.example). Every setting is explained in docs/self-hosting/configuration.md.

# ---- Required ----
# Public address of the site, with scheme and no trailing slash. Used in emails and CSRF checks.
SITE_URL=http://localhost:8080
# Long random value, e.g.  openssl rand -base64 48   (changing it signs everyone out)
DJANGO_SECRET_KEY=
# Database password. Keep it URL-safe (letters and digits): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Hostnames the API answers to, comma separated (a leading dot also matches subdomains).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- HTTPS ----
# The defaults below let you try Doory over plain http://localhost. Behind a TLS-terminating proxy
# (production), set both to true.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false
# Reverse proxies between the internet and the API, as seen by rate limiting (bundled nginx = 1;
# add one for each extra proxy that does not rewrite X-Forwarded-For).
NUM_PROXIES=1

# ---- Ports and build options ----
WEB_PORT=8080
# Interface the web port is published on. Use 127.0.0.1 when a reverse proxy on the same host fronts it.
WEB_BIND=0.0.0.0
# Build headless Chromium into the API image for server-side PDF export (adds ~400 MB). false = off.
INSTALL_CHROMIUM=true
# Build ffmpeg into the API image for video clips: uploads and stock videos (adds ~250 MB). false = no video.
INSTALL_FFMPEG=true
# Build mozjpeg and oxipng into the API image for the built-in image optimizer (adds ~2 MB). false = off.
INSTALL_IMAGE_OPTIMIZERS=true

# ---- Optional: first-run content (the commands are listed in docs/self-hosting/content.md) ----
# Without it a new site has no icons, emoji or illustrations, no fonts besides the system ones and no
# background-removal model. These flags run the downloads inside the API container *before* it starts
# serving; a failed download is logged and never stops the server. The first start can take minutes
# (Compose reports the API as unhealthy for as long as it takes), so for a first install you may prefer
# `docker compose exec api python manage.py ...` once the stack is up, and these flags afterwards.
# Template categories: docker compose exec api python manage.py seed_gallery

# Element library (icons, emoji, illustrations, shapes, graphics): about 27 500 elements,
# about 40 s and 120-130 MB on disk the first time, a second afterwards. true: run on every start.
DOORY_SYNC_ELEMENTS=false
# Extra arguments for `manage.py sync_element_packs`, e.g. --pack lucide phosphor-regular
DOORY_SYNC_ELEMENTS_ARGS=
# Brand logos (Facebook, LinkedIn, YouTube, ...) from the icon sets. Off by default: logos are trademarks of
# their owners and must be used according to their brand guidelines. true: the next sync adds them, tagged
# "brand" and "logo". false again: the next sync unpublishes them (designs that already use a logo keep their
# copy); turning it back on does not republish them, staff do that in the admin.
DOORY_ELEMENTS_BRAND_LOGOS=false

# Font catalog (OFL fonts from Fontsource via jsDelivr). true: download once, on the first start.
DOORY_SYNC_FONTS=false
# Which families (default when empty: the 100 most popular, about 6 MB). e.g. --popular 253 or --all
DOORY_SYNC_FONTS_ARGS=

# The ten starter templates (backend/data/templates, with thumbnails). true: add them on every start. Add-only:
# a template that already exists is never changed, so edits made in the admin survive. Needs the fonts above.
DOORY_SEED_TEMPLATES=false

# Background-removal model (U2-Net small, Apache-2.0, 4.6 MB, into MEDIA_ROOT/models/). true: run on every
# start (an installed model costs a hash check, no download).
DOORY_SYNC_MODELS=false
# Extra arguments for `manage.py sync_models`, e.g. --model u2net (176 MB) or --all
DOORY_SYNC_MODELS_ARGS=

# Audio library (24 music loops and 88 sound effects, CC0, about 7 MB, into MEDIA_ROOT/audio/): installed from the
# files in the image, no download. true: run on every start (installed files cost a hash check).
DOORY_SYNC_AUDIO=false
# Extra arguments for `manage.py sync_audio`, e.g. --pack some-pack (optional CC0 packs listed in the manifest)
DOORY_SYNC_AUDIO_ARGS=

# ---- Optional: server-side image export (PNG/JPG/WebP/AVIF of design pages). Off by default. ----
# Needs INSTALL_CHROMIUM=true. Turning it on runs the editor's engine (JavaScript) in the export browser.
# SERVER_IMAGE_EXPORT_ENABLED=true
# The frontend's headless render page, as the API and MCP containers reach it (the web service on the
# compose network). It must be the built frontend: the export browser only loads this page and /assets/.
# EXPORT_RENDER_PAGE_URL=http://doory-web:8080/render.html
# Largest output in pixels (width x height, after scaling) and largest design document drawn.
# EXPORT_IMAGE_MAX_PIXELS=40000000
# EXPORT_IMAGE_MAX_DOCUMENT_BYTES=5242880
# Most pages one export draws (sent back as a ZIP). They are drawn one after another in one request: keep
# pages x EXPORT_TIMEOUT_SECONDS under the web server's worker timeout (120 s in the Docker image).
# EXPORT_IMAGE_MAX_PAGES=10
# Videos (MP4, WebM, GIF) of saved designs, also off by default; needs SERVER_IMAGE_EXPORT_ENABLED too. One video
# keeps a browser busy for up to EXPORT_VIDEO_TIMEOUT_SECONDS (the bundled nginx waits 330 s for it).
# SERVER_VIDEO_EXPORT_ENABLED=true
# EXPORT_VIDEO_TIMEOUT_SECONDS=300
# EXPORT_VIDEO_MAX_SECONDS=120
# EXPORT_VIDEO_MAX_RESOLUTION=1080
# EXPORT_VIDEO_MAX_BYTES=209715200

# ---- Optional: image optimizers (docs/integrations/image-optimization.md) ----
# Make exported and downloaded images smaller. Which ones people may pick, in order (empty: none); one that
# isn't set up (no key, or for builtin no mozjpeg/oxipng) is left out. Files never get bigger, and a failing
# optimizer leaves the file unoptimized with a note.
# IMAGE_OPTIMIZERS=builtin
# IMAGE_OPTIMIZER_DEFAULT=builtin
# IMAGE_OPTIMIZER_TIMEOUT=30
# IMAGE_OPTIMIZER_MAX_BYTES=26214400
# These send the image to that service:
# TINYPNG_API_KEY=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# Any optimizer that follows the custom contract (on a private network: add its host to AI_ALLOWED_PRIVATE_HOSTS).
# IMAGE_OPTIMIZER_CUSTOM_NAME=Custom
# IMAGE_OPTIMIZER_CUSTOM_URL=https://optimizer.example.com/v1/optimize
# IMAGE_OPTIMIZER_CUSTOM_KEY=

# ---- Optional: filling templates by field key (fill / bulk fill, REST and MCP) ----
# BULK_FILL_MAX_ROWS=100       # rows per bulk fill; on REST each row counts against the bulk_fill rate (120/min),
#                               over MCP against MCP_CALLS_PER_MINUTE; each new image URL against the bulk_fill_images
#                               rate (300/min, not the upload rate); each exported image against the export rate (30/min). Many URL images or exports make one long request: lower this if requests hit
#                               the worker timeout.
# URL_IMAGE_UPLOADS=true       # copy images from public https URLs (upload_image_from_url, and image values
#                               of fill / bulk fill); the old name MCP_URL_UPLOADS still works

# ---- Optional: export file names ----
# simple: summer-sale-02.png (the default). structured: <title>_<platform>_<preset>_<W>x<H>[_p02][_<unix>].png,
# e.g. summer-sale_instagram_instagram-story_1080x1920_p02.png. People can still switch in the download dialog.
# EXPORT_FILENAME_STYLE=simple
# Structured names end in the Unix time of the export (one per export, shared by every file and the ZIP).
# EXPORT_FILENAME_TIMESTAMP=false

# ---- Optional: your own size presets ----
# The sizes offered when creating or resizing a design. The built-in ones are added on the first migration
# and can be edited in the admin (Size presets). To manage them as a file instead, point this at a JSON file
# inside the API container (mount it, see docker-compose.yml); it is imported on every start, so editing the
# file and restarting updates the site's sizes. The format is in docs/self-hosting/content.md. Empty: no import.
DOORY_SIZE_PRESETS_FILE=
# extend: the file adds to the built-in sizes (a preset with the same slug replaces the built-in one).
# replace: only the file's groups and sizes are offered; the others are switched off, not deleted.
DOORY_SIZE_PRESETS_MODE=extend

# ---- Optional: email (default prints emails to the container log) ----
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=Doory <no-reply@example.com>

# ---- Optional: Google sign-in (OAuth web client ID) ----
# GOOGLE_CLIENT_ID=

# ---- Optional: stock photo search (a provider is offered when its key is set) ----
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Which providers are on, in tab order; the "All" tab searches STOCK_ALL_PROVIDERS (empty: all of them) in parallel.
# STOCK_PROVIDERS=unsplash,pexels,pixabay
# STOCK_ALL_PROVIDERS=
# STOCK_ALL_TIMEOUT_SECONDS=4
# STOCK_DEFAULT_TAB=all
# Per provider (UNSPLASH, PEXELS, PIXABAY): search cache time (3600 s; Pixabay 86400 s), safe search (Unsplash off,
# Pixabay on) and a cap on calls per API key across all users. No cap is set by default: Doory then only pauses a
# provider when it answers 429 or reports its quota used up. The providers' published limits, to set as caps:
# Unsplash 50/h (demo) or 5000/h (production), Pexels 200/h, Pixabay 100/m.
# STOCK_UNSPLASH_RATE=5000/h
# STOCK_UNSPLASH_SAFESEARCH=false
# STOCK_PIXABAY_CACHE_SECONDS=86400
# STOCK_PIXABAY_RATE=100/m
# STOCK_PIXABAY_SAFESEARCH=true
# STOCK_PIXABAY_IMAGE_TYPE=photo   # photo, illustration, vector or all
# STOCK_LANG_FROM_UI=true          # search Pixabay in the UI language

# Stock videos in the Videos tool (needs ffmpeg, see INSTALL_FFMPEG). Keys of their own keep clip searches off the
# photo quota; without them each video provider uses its photo key above.
# PEXELS_VIDEO_API_KEY=
# PIXABAY_VIDEO_API_KEY=
# STOCK_VIDEO_PROVIDERS=pexels_video,pixabay_video
# STOCK_PEXELS_VIDEO_RATE=200/h
# STOCK_PIXABAY_VIDEO_CACHE_SECONDS=86400

# ---- Optional: video clips (docs/self-hosting/video.md) ----
# VIDEO_ENABLED=true                     # the Docker image sets it from INSTALL_FFMPEG
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# MAX_VIDEO_UPLOAD_BYTES=209715200       # 200 MB; raise nginx's client_max_body_size for /api/v1/assets/ with it
# MAX_VIDEO_DURATION_SECONDS=600
# VIDEO_MAX_CONCURRENCY=2
# VIDEO_TRANSCODE_TIMEOUT_SECONDS=900
# VIDEO_DOWNLOAD_DEADLINE_SECONDS=90
# VIDEO_WORK_DIR=

# Freesound tab in the Audio tool (off without a key; https://freesound.org/apiv2/apply/). Sounds are CC0 only
# unless FREESOUND_LICENSES=cc0,by also allows CC BY (the editor then shows the credits to publish). Freesound's
# API terms cover non-commercial use: a commercial service needs an agreement with Freesound first.
# FREESOUND_API_KEY=
# FREESOUND_LICENSES=cc0
# STOCK_FREESOUND_CACHE_SECONDS=86400
# STOCK_FREESOUND_RATE=60/m

# ---- Optional: AI image providers (remote servers for background removal; in-browser removal stays the default) ----
# The bundled reference AI server (Docker): add `ai` to COMPOSE_PROFILES (see the MCP section), set a key, and
# point provider 1 at it:
# AI_SERVER_API_KEY=                   # required; e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# AI_PROVIDER_1_URL=http://ai-server:7000
# AI_PROVIDER_1_STYLE=doory
# AI_PROVIDER_1_AUTH_HEADER=Authorization
# AI_PROVIDER_1_AUTH_VALUE=Bearer <the same key>
# AI_ALLOWED_PRIVATE_HOSTS=ai-server
# Its tuning:
# AI_SERVER_MODELS=isnet-general-use,u2netp   # baked into the image at build time; rebuild after changing it
# AI_SERVER_DEFAULT_MODEL=isnet-general-use
# AI_SERVER_WORKERS=1                  # images processed at once; more requests are answered "busy" (429)
# AI_SERVER_THREADS=4
# AI_SERVER_MEM_LIMIT=2g
#
# Operator providers, AI_PROVIDER_1_* … AI_PROVIDER_9_* (also configurable in the admin under "AI providers").
# STYLE says how the server's API looks: doory (Doory's own contract, served at /api/v1/ai/contract.yaml), multipart
# (file upload → PNG), json (base64 in a JSON answer), mask (a black and white mask Doory applies) or custom.
# AI_PROVIDER_1_URL=http://model-server:7000
# AI_PROVIDER_1_STYLE=doory
# AI_PROVIDER_1_STYLE_CONFIG=          # JSON, e.g. {"path": "/remove", "file_field": "image"} (see the admin's help)
# AI_PROVIDER_1_TASKS=background-removal
# AI_PROVIDER_1_MODELS=                # name:Label,name2:Label2; empty: the server's own list (doory) or default
# AI_PROVIDER_1_AUTH_HEADER=           # e.g. Authorization or X-Api-Key
# AI_PROVIDER_1_AUTH_VALUE=            # sent as is (e.g. "Bearer …"); never shown in the browser or the logs
# AI_PROVIDER_1_LABEL=High quality (server)
# AI_PROVIDER_1_SENDS_OFFSITE=false    # true: the editor tells users their image leaves this installation
# AI_PROVIDER_1_TIMEOUT_SECONDS=60
# AI_PROVIDER_1_MAX_IMAGE_BYTES=       # empty: AI_MAX_IMAGE_BYTES
# AI_PROVIDER_1_DAILY_QUOTA=0          # calls per user per day; 0 = unlimited
# A provider on a private network is reached only by IP address or by a host name listed here:
# AI_ALLOWED_PRIVATE_HOSTS=model-server
# BACKGROUND_REMOVAL_DEFAULT=device    # device, or an option id from /api/v1/ai/models/ (e.g. env-1:best)
# The editor's notice under options with SENDS_OFFSITE=true; empty: "The image is sent to an external service."
# AI_OFFSITE_NOTICE=
# AI_PROVIDERS_ENABLED=true
# Users' own servers ("bring your own server"): off, staff or everyone. Their servers must be public https hosts.
# AI_USER_PROVIDERS=off
# AI_USER_PROVIDERS_ALLOW_HTTP=false
# Ports users' own servers may use: 443 and 8443 always (80 and 8080 too with ALLOW_HTTP); add more here.
# AI_USER_PROVIDERS_ALLOWED_PORTS=9443
# AI_MAX_PROVIDERS_PER_USER=10
# Key that encrypts stored provider secrets (a Fernet key). Empty: derived from DJANGO_SECRET_KEY, so changing
# that key needs the old one in DJANGO_SECRET_KEY_FALLBACKS, or stored secrets must be entered again. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_SECRETS_KEY=
# AI_SECRETS_KEY_FALLBACKS=            # earlier keys, still accepted for reading
# AI_DEFAULT_TIMEOUT_SECONDS=60
# AI_MAX_IMAGE_BYTES=26214400
# AI_CACHE_SECONDS=604800              # identical requests (same image, option and settings) reuse the result

# ---- Optional: MCP server for AI assistants (/mcp; tokens are made in Settings). Off by default. ----
# MCP_ENABLED=true
# COMPOSE_PROFILES=mcp,ai      # Docker: optional services to start (`mcp`, `ai` for the reference AI server)
# MCP_CALLS_PER_MINUTE=120     # per user; 0 = unlimited
# MCP_WORKERS=1                # uvicorn workers of the `mcp` service (Docker)
# MCP_MEM_LIMIT=1g             # memory cap of the `mcp` service (Docker; export_design runs Chromium in it)
# MCP_EXPORT_INLINE_MAX_BYTES=1048576   # export_design and bulk fill exports: larger images are sent as a download link
# MCP_EXPORT_URL_TTL_SECONDS=600        # how long those links work

# ---- Optional: S3-compatible media storage instead of the local volume ----
# USE_S3=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
